# PORT: HTTP and WebSocket server port (default: 3000)
PORT="3000"

# APP_URL: Public URL where ClassicPlay is hosted.
APP_URL="MY_APP_URL"

# OUTCOME_SIGNING_SECRET: Secret used by server.ts for HMAC-SHA256 authoritative match receipts.
OUTCOME_SIGNING_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"

# GEMINI_API_KEY: Server-side API key if server features require it (never expose in client).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
