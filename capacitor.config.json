{
  "appId": "com.boardora.teninone",
  "appName": "BOARDORA",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#08172F"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#08172F",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#08172F",
      "overlaysWebView": false
    }
  }
}
